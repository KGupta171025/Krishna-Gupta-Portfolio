# ==========================================================
# Local Flask Environment Configuration Example
# Copy this file to .env and replace with your credentials
# ==========================================================

# 1. SMTP Email Server Configuration (e.g. Gmail App Passwords)
SMTP_EMAIL_USER=your_email@gmail.com
SMTP_EMAIL_PASS=your_app_specific_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 2. Twilio SMS Configuration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
MY_PHONE_NUMBER=+91XXXXXXXXXX

# 3. Security & Admin Authentication
FLASK_SECRET=your-random-flask-secret-key
ADMIN_USERNAME_HASH=your_sha256_admin_username_hash
ADMIN_PASSWORD_HASH=your_argon2_admin_password_hash
API_ACCESS_TOKEN=your_admin_bearer_access_token
CATALOG_DB_KEY=your_fernet_encryption_key

# 4. Multi-Tier Rate Limiting Configuration
# Authentication Routes (Strict + Dual-Key IP & Account Exponential Backoff)
RATE_LIMIT_AUTH_IP_LIMIT=5
RATE_LIMIT_AUTH_IP_WINDOW=60
RATE_LIMIT_AUTH_MAX_ATTEMPTS=3
RATE_LIMIT_AUTH_BASE_BACKOFF=2.0
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2.0
RATE_LIMIT_AUTH_MAX_BACKOFF=900.0
RATE_LIMIT_AUTH_ACCOUNT_WINDOW=900

# Public Endpoints (Moderate Limits)
RATE_LIMIT_PUBLIC_CONTACT_LIMIT=5
RATE_LIMIT_PUBLIC_CONTACT_WINDOW=60
RATE_LIMIT_PUBLIC_CHAT_LIMIT=15
RATE_LIMIT_PUBLIC_CHAT_WINDOW=60
RATE_LIMIT_PUBLIC_DOWNLOAD_LIMIT=30
RATE_LIMIT_PUBLIC_DOWNLOAD_WINDOW=60
RATE_LIMIT_PUBLIC_GENERAL_LIMIT=60
RATE_LIMIT_PUBLIC_GENERAL_WINDOW=60

# Authenticated User & Admin Actions (Looser Limits)
RATE_LIMIT_AUTHENTICATED_LIMIT=120
RATE_LIMIT_AUTHENTICATED_WINDOW=60
